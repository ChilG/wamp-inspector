{
  "name": "wamp-inspector",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/package-extension.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test",
    "typecheck": "tsc --noEmit && tsc -p e2e",
    "test:e2e": "playwright test e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "ws": "8.23.0"
  }
}
