{
  "manifest_version": 3,
  "name": "WAMP Inspector",
  "version": "0.1.3",
  "description": "Inspect WAMP WebSocket connections and messages in Chrome DevTools. Filter traffic, view JSON payloads, and track latency.",
  "icons": {
    "16": "icons/wamp-16.png",
    "32": "icons/wamp-32.png",
    "48": "icons/wamp-48.png",
    "128": "icons/wamp-128.png"
  },
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/capture/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/capture/content-script.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/capture/hook.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "devtools_page": "src/devtools/devtools.html",
  "action": {
    "default_title": "WAMP Inspector",
    "default_icon": {
      "16": "icons/wamp-16.png",
      "32": "icons/wamp-32.png"
    },
    "default_popup": "src/popup/popup.html"
  }
}
