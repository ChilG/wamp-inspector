{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["chrome"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/shared/*.d.ts",
    "src/shared/*.js",
    "src/capture/background.js",
    "src/devtools/panel-capture-stream.js",
    "src/devtools/panel-mock.js",
    "src/devtools/panel-mock-response.js",
    "tests/types/*.ts"
  ]
}
